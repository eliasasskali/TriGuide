    "race_nutrition_calculator-carbs-estimation-information-description" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquestes recomanacions són una guia, especialment per a esportistes sense un estómac entrenat. La tolerància de cada persona és diferent, així que és millor provar i descobrir què funciona per a tu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These recommendations are a guide, especially for athletes without gut training. Everyone’s tolerance is different, so it’s best to experiment and find what works for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas recomendaciones son una guía, especialmente para deportistas sin un estómago entrenado. La tolerancia de cada persona es diferente, así que es mejor probar y descubrir qué funciona para ti."
          }
        }
      }
    },
