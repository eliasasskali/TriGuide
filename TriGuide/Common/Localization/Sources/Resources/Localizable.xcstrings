    "race_nutrition_calculator-fasted-state-information-description" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu cos utilitza més greix si no has menjat abans de l’esforç, així que les necessitats de carbohidrats són més baixes. Fes servir-ho si comences la sessió sense menjar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body burns more fat when you haven’t eaten before the effort, so your carb needs are lower. Use this if you start the session without a meal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuerpo quema más grasa si no has comido antes del esfuerzo, por lo que tus necesidades de carbohidratos son menores. Úsalo si empiezas la sesión sin comer."
          }
        }
      }
    },
