    "race_nutrition_calculator-ambient-temperatur-information-description" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les condicions més calentes augmenten lleugerament l’ús de carbohidrats. El cos depèn més dels carbohidrats per mantenir el rendiment amb calor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotter conditions increase carb usage slightly. Your body relies more on carbs to maintain performance in heat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las condiciones más cálidas aumentan ligeramente el uso de carbohidratos. El cuerpo depende más de los carbohidratos para mantener el rendimiento con calor."
          }
        }
      }
    },
