#!/bin/sh

# Get list of staged Swift files
SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$')

if [ -z "$SWIFT_FILES" ]; then
    # No Swift files staged, exit successfully
    exit 0
fi

# Check if swiftformat is installed
if ! command -v swiftformat &> /dev/null; then
    echo "Error: swiftformat is not installed. Please install it first."
    echo "You can install it via Homebrew: brew install swiftformat"
    exit 1
fi

echo "Running SwiftFormat on staged Swift files..."

# Run swiftformat on each staged file
echo "$SWIFT_FILES" | while read file; do
    if [ -f "$file" ]; then
        echo "  Formatting $file"
        swiftformat "$file"
        # Re-stage the formatted file
        git add "$file"
    fi
done

echo "SwiftFormat complete!"
exit 0
